# VM 部署构建专用 (npm run build:pb-vm)
# PB 地址用相对路径 "/"：页面和 PB API 同源（server.js 把 /api 代理到本机 PB）
# 注意：不要用 shell 传 VITE_PB_URL=/ —— Git Bash 会把 "/" 转成 "C:/Program Files/Git"
VITE_DATA_SOURCE=pb
VITE_PB_URL=/
# 启用登录（Phase 6, 2026-06-10）；切回免登录需同步把 VM .env 的 PB_INJECT_TOKEN 改回 on
VITE_PB_LOGIN=on
# Phase 3a 写开关（打卡/照片/记账）；出问题改 off 退回只读
VITE_PB_WRITES=on
